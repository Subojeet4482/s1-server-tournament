# Server-1  account / balance / match / leaderboard
# Render -> Environment: add every line below (never commit a real .env)

SERVER_ID=s1
# service-account JSON  ->  base64:   base64 -w0 serviceAccount.json   (Windows: python tools/make_b64.py file.json)
# DB-1 = MAIN Firebase project (users, matches, wallet, leaderboard + Firebase Auth of the user app)
DB1_FIREBASE_CREDENTIALS_B64=

# ---------- other servers (direct Render URLs) ----------
S2_URL=https://ff-server2-history.onrender.com
S4_URL=https://ff-server4-backup.onrender.com
S5_URL=https://ff-server5-fraud.onrender.com

# ---------- wallet rules ----------
MIN_WITHDRAW=10   # only used if the admin panel has not set config/banner.minWithdraw
MAX_WITHDRAW=50000
WITHDRAW_FEE=2
MIN_DEPOSIT=5
DEPOSIT_GIVEUP_MIN=10

# MUST be the same value as LB_ADMIN_KEY of the load balancer (the Telegram bot edits the state-ban settings through it)
ADMIN_API_KEY=

# ---------- STATE PAYMENT BAN (Andhra Pradesh, Assam, Odisha, Telangana, Nagaland, Sikkim by default) ----------
# The list, the switches and the message are edited from the Telegram bot (State payment block). Values below are only the starting defaults.
GEO_ENABLED=true
GEO_BLOCKED_STATES=
# IP -> state lookup, tried in this order (free, no key). Optional paid-accuracy provider: set IPINFO_TOKEN.
GEO_PROVIDERS=ipwhois,ipapi
IPINFO_TOKEN=
# false = if the IP cannot be located the user is NOT blocked (declared state still counts). true = block unknown locations.
GEO_FAIL_CLOSED=false
# a blocked IP seen in the last N days keeps the block even after the user switches IP / VPN (0 = off)
GEO_STICKY_DAYS=3
# a user may change his declared state once in N days
STATE_CHANGE_DAYS=30

# ---------- SECRETS (SAME value in ALL 5 servers + load balancer) ----------
# generate:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
INTERNAL_KEY=

# ---------- ANTI-BYPASS: only the load balancer may call this server (it sends INTERNAL_KEY). Keep true. ----------
REQUIRE_LB=true

# ---------- Render free: self ping so the service does not sleep (Render gives RENDER_EXTERNAL_URL itself) ----------
KEEPALIVE=true
KEEPALIVE_INTERVAL=600
THREADS=16

# Refer & Earn: the link users share is SITE_URL/?ref=<playerId>  (your user-panel domain)
SITE_URL=https://ffcashbattle.in
